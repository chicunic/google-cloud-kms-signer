{
  "name": "google-cloud-kms-signer",
  "version": "0.1.0",
  "private": true,
  "description": "Import Ethereum private keys into Google Cloud KMS and sign with them",
  "keywords": [
    "ethereum",
    "kms",
    "google-cloud",
    "signer",
    "secp256k1",
    "ethers",
    "typescript"
  ],
  "license": "MIT",
  "author": "chicunic",
  "repository": "git@github.com:chicunic/google-cloud-kms-signer.git",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsc6 -p tsconfig.build.json",
    "test": "vitest run",
    "check": "tsc6 && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-crypto/crc32c": "^5.2.0",
    "@google-cloud/kms": "^6.3.0",
    "@peculiar/asn1-ecc": "^3.0.0",
    "@peculiar/asn1-schema": "^3.0.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "ora": "^10.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
